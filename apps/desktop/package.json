{
  "name": "zcode-status-light-desktop",
  "version": "0.2.0-alpha.6",
  "private": true,
  "description": "Electron desktop runtime for ZCode Status Light.",
  "author": "ZCodeStatusLight contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NNNSX/zcode-status-widget.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/NNNSX/zcode-status-widget/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:electron": "wait-on tcp:127.0.0.1:5174 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .",
    "build": "npm run build:main && vite build",
    "dist:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\build-windows.ps1",
    "package:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\package-release.ps1",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "lint": "eslint .",
    "test:hook-helper": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\test-hook-helper.ps1",
    "test": "npm run test:hook-helper && vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort"
  },
  "build": {
    "appId": "com.zcode.statuslight",
    "productName": "ZCode Status Light",
    "directories": {
      "output": "artifacts/windows",
      "buildResources": "assets"
    },
    "electronLanguages": ["zh-CN", "en-US"],
    "extraResources": [
      {
        "from": "assets/tray.png",
        "to": "assets/tray.png"
      },
      {
        "from": "assets/hook/ZCodeStatusHook.exe",
        "to": "hook/ZCodeStatusHook.exe"
      }
    ],
    "files": [
      "out/**",
      "dist/**",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "assets/installer.nsh"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico",
      "signExecutable": false
    }
  },
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
