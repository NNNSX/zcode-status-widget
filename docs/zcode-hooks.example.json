{
  "enabled": true,
  "events": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "<PYTHON_EXE>",
            "args": [
              "<INSTALL_ROOT>\\hook_handler.py",
              "user_prompt_submit",
              "${CLAUDE_SESSION_ID}",
              "${ZCODE_PROJECT_DIR}"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "<PYTHON_EXE>",
            "args": [
              "<INSTALL_ROOT>\\hook_handler.py",
              "permission_request",
              "${CLAUDE_SESSION_ID}",
              "${ZCODE_PROJECT_DIR}"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "process",
            "command": "<PYTHON_EXE>",
            "args": [
              "<INSTALL_ROOT>\\hook_handler.py",
              "todo_update",
              "${CLAUDE_SESSION_ID}",
              "${ZCODE_PROJECT_DIR}"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "<PYTHON_EXE>",
            "args": [
              "<INSTALL_ROOT>\\hook_handler.py",
              "tool_failure",
              "${CLAUDE_SESSION_ID}",
              "${ZCODE_PROJECT_DIR}"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "<PYTHON_EXE>",
            "args": [
              "<INSTALL_ROOT>\\hook_handler.py",
              "stop",
              "${CLAUDE_SESSION_ID}",
              "${ZCODE_PROJECT_DIR}"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
